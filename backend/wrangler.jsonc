{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kurs-world-api",
  "account_id": "199b92b58516647d806e121b0f4a34cc",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kurs-world-db",
      "database_id": "60645050-408c-4710-8498-e49671ab18e7",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KURS_CACHE",
      "id": "ecbd16282ee1400fb8913e7356c829b1"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "kurs_world_telemetry"
    }
  ],
  "observability": {
    "enabled": true
  }
}
